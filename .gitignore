# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# Database (runtime generated)
data/*.db

# AI 配置（含 API Key，绝不提交）
data/settings.json
data/settings.json.*

# 分享版标记（打包时写入，表示 Key 由分享者提供）
data/SHARED_BUILD
*.spec

# 独立窗口模式用的 Edge/Chrome 缓存目录
# 会生成上千个文件、上百 MB，绝不能被 git 跟踪
data/browser_profile/
browser_profile/

# 随包分发的独立 Chromium（V1.8）
# 约 400MB，绝不能进 git。构建前需手动放到这里，见 build_exe.py 顶部说明。
browser/
# 下载/解压 Chromium 时的中间产物
_chromium*.zip
_chromium_x/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env
.env
.venv/
venv/

# ECharts local cache (large binary, CDN fallback ok)
# static/js/echarts.min.js

# 内部协作规范（含 agent 代号与工作流程，不公开）
AGENT_COLLABORATION_RULES.md
